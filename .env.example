# ---- Cluster ----
SOLANA_CLUSTER=devnet                       # localnet | devnet | mainnet-beta
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_API_KEY=
YELLOWSTONE_GRPC_URL=                        # geyser gRPC for the indexer (mainnet)
YELLOWSTONE_X_TOKEN=

# ---- Keys (never commit real ones) ----
KEEPER_KEYPAIR_PATH=./keys/keeper.json       # hot key: oracle pushes, claims, payouts, migrations
ADMIN_KEYPAIR_PATH=./keys/admin.json         # devnet only; mainnet admin = Squads multisig
ADMIN_MULTISIG=                              # Squads vault pubkey on mainnet

# ---- Program IDs (filled by scripts/deploy.ts) ----
PEG_DESK_PROGRAM_ID=PegDesk111111111111111111111111111111111111
FEE_ROUTER_PROGRAM_ID=FeeRoutr111111111111111111111111111111111111
DISTRIBUTOR_PROGRAM_ID=Distrib1111111111111111111111111111111111111
BUYBACK_PROGRAM_ID=Buyback1111111111111111111111111111111111111

# ---- External programs ----
DBC_PROGRAM_ID=dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
DAMM_V2_PROGRAM_ID=cpamdpZCGKUy5JxQXB4dcpGPiikHawvSWAd6mEn1sGG
PYTH_RECEIVER_PROGRAM_ID=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ
# USDC (peg_desk reserve mint) is selected by SOLANA_CLUSTER from @icemarkets/registry `USDC` — keeper,
# scripts and web all use the same rule. Override only for localnet / a custom test mint:
# USDC_MINT_OVERRIDE=

# ---- Oracles / data ----
HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=                                 # required for Hermes price updates since 2026-08-26 (docs.pyth.network); feed lookups work without it
SWITCHBOARD_QUEUE=                           # on-demand queue pubkey
PRICEMPIRE_API_KEY=
CSFLOAT_API_KEY=
POKEMONTCG_API_KEY=
DATA_VENDOR_API_KEY=                          # Databento / Barchart for non-Pyth futures
WATCHCHARTS_API_KEY=                          # watches category: sources/watches.ts
COLLECTORCRYPT_COLLECTION=                    # Collector Crypt vault collection address (Helius DAS getAssetsByGroup)
COLLECTORCRYPT_API_URL=                       # optional: Collector Crypt REST API base (fallback if the Helius DAS path fails)

# ---- Keeper cadences (seconds) ----
ORACLE_PUSH_INTERVAL=30
FEE_CYCLE_INTERVAL=900
FEE_MIN_CLAIM_USD=100                         # keeper claims DBC/DAMM fees once unclaimed ≥ this (USD)
PAYOUT_MIN_POOL_USD=100
PAYOUT_MIN_HOLDING_USD=5
PAYOUT_MIN_AMOUNT_USD=1
IDL_DIR=./target/idl                          # keeper/scripts read <name>.json here (anchor build output)
GLD_IS_TOKEN_A=false                          # buyback: GLD side of the ICE/GLD DAMM v2 pool
BUYBACK_SLIPPAGE_BPS=50                       # buyback: min_ice_out = DAMM v2 quote × (1 − this)
BUYBACK_MIN_LIQUIDITY_MULT=20                 # buyback: skip unless the pool's GLD reserve ≥ this × trade size

# ---- Seeding (scripts/seed-commodities.ts, create-index-coin.ts) ----
TREASURY_PUBKEY=                              # peg_desk GlobalConfig.treasury (default: admin)
KEEPER_PUBKEYS=                               # comma-separated; set_keepers on peg_desk
METADATA_BASE_URI=                            # <base>/<SYMBOL>.json Metaplex metadata
# SEED_PRICE_<SYMBOL>=123.45                  # USD seed price for coins without a Hermes/manual price
# SEED_SYMBOLS=GLD,SLV                       # optional: only seed these symbols this run (resumable)

# ---- Indexer (apps/indexer) ----
PORT=4000                                     # REST API
WEBHOOK_PORT=4001                             # Helius webhook receiver (POST /helius)
HELIUS_WEBHOOK_AUTH_HEADER=                   # shared secret Helius echoes in Authorization (optional)
# The webhook fetches program logs via RPC_URL for Helius "enhanced" deliveries (Anchor events need logs).

# ---- Storage / web ----
DATABASE_URL=postgres://icemarkets:icemarkets@localhost:5432/icemarkets
IRYS_PRIVATE_KEY_PATH=./keys/irys.json
NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
NEXT_PUBLIC_API_URL=http://localhost:4000
# The web app reads SOLANA_CLUSTER / USDC_MINT_OVERRIDE above at build time (apps/web/next.config.ts).
NEXT_PUBLIC_LAUNCH_ALT=                       # optional; default = addressLookupTable in /deployments/<cluster>.json (make alt)
NEXT_PUBLIC_IDL_BASE=/idl                     # peg_desk.json served from apps/web/public/idl (make build)
NEXT_PUBLIC_TREASURY=                         # DBC leftoverReceiver (default: fee_router router PDA)
GEOBLOCK_COUNTRIES=US,GB,CU,IR,KP,SY,RU,BY
