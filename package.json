{
  "name": "icemarkets",
  "private": true,
  "version": "0.1.0",
  "description": "ICEmarkets \u2014 Commodity Market Exchange on Solana. Memecoins paired with commodity coins; 40% of fees to holders.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "dev:web": "pnpm --filter @icemarkets/web dev",
    "dev:keeper": "pnpm --filter @icemarkets/keeper dev",
    "dev:indexer": "pnpm --filter @icemarkets/indexer dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "anchor test",
    "anchor:build": "anchor build",
    "registry:validate": "pnpm --filter @icemarkets/registry validate"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "embedded-postgres": "18.4.0-beta.17",
    "mocha": "^10.8.2",
    "prettier": "^3.4.2",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1"
  },
  "pnpm": {
    "overrides": {
      "jito-ts>@solana/web3.js": "^1.99.0"
    }
  }
}
