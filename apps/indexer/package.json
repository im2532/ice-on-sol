{
  "name": "@icemarkets/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "REST API + Helius webhook ingester backing apps/web. Reads/writes Postgres per schema.sql.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "webhook": "tsx watch src/webhook.ts",
    "candles": "tsx src/candles.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@icemarkets/registry": "workspace:*",
    "@solana/web3.js": "^1.98.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
