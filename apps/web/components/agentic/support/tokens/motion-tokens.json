{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "motion": {
    "duration": {
      "instant":  { "$value": { "value": 0,   "unit": "ms" }, "$type": "duration" },
      "micro":    { "$value": { "value": 70,  "unit": "ms" }, "$type": "duration" },
      "quick":    { "$value": { "value": 100, "unit": "ms" }, "$type": "duration" },
      "base":     { "$value": { "value": 150, "unit": "ms" }, "$type": "duration" },
      "moderate": { "$value": { "value": 240, "unit": "ms" }, "$type": "duration" },
      "standard": { "$value": { "value": 300, "unit": "ms" }, "$type": "duration" },
      "slow":     { "$value": { "value": 500, "unit": "ms" }, "$type": "duration" },
      "glacial":  { "$value": { "value": 700, "unit": "ms" }, "$type": "duration" }
    },
    "easing": {
      "easeOut":      { "$value": [0, 0, 0.2, 1],           "$type": "cubicBezier" },
      "easeIn":       { "$value": [0.4, 0, 1, 1],           "$type": "cubicBezier" },
      "easeInOut":    { "$value": [0.4, 0, 0.2, 1],         "$type": "cubicBezier" },
      "spring":       { "$value": [0.34, 1.56, 0.64, 1],    "$type": "cubicBezier" },
      "emphasized":   { "$value": [0.05, 0.7, 0.1, 1.0],    "$type": "cubicBezier" },
      "emphasizedOut":{ "$value": [0.3, 0.0, 0.8, 0.15],    "$type": "cubicBezier" },
      "standard":     { "$value": [0.4, 0, 0.6, 1],         "$type": "cubicBezier" }
    }
  }
}
